{
  "name": "olliecode",
  "version": "0.5.1",
  "description": "An agentic coding tool powered by Ollama - local, private, and fast",
  "author": "Frank Cooke <frankcooke79@gmail.com>",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ollielabs/olliecode.git"
  },
  "homepage": "https://github.com/ollielabs/olliecode#readme",
  "bugs": {
    "url": "https://github.com/ollielabs/olliecode/issues"
  },
  "keywords": [
    "cli",
    "ai",
    "ollama",
    "coding-assistant",
    "agentic",
    "terminal",
    "tui",
    "local-llm"
  ],
  "bin": {
    "ollie": "src/index.tsx"
  },
  "files": [
    "src",
    "bunfig.toml"
  ],
  "engines": {
    "bun": ">=1.0.0"
  },
  "module": "src/index.tsx",
  "type": "module",
  "scripts": {
    "dev": "bun run src/index.tsx",
    "build": "bun run build.ts",
    "build:darwin-arm64": "bun run build.ts --target=bun-darwin-arm64 --outfile=dist/ollie-darwin-arm64",
    "build:darwin-x64": "bun run build.ts --target=bun-darwin-x64 --outfile=dist/ollie-darwin-x64",
    "format": "bunx biome format",
    "format:fix": "bunx biome format --fix",
    "lint": "bunx biome lint",
    "lint:fix": "bunx biome lint --fix",
    "check:types": "tsc --noEmit",
    "changeset": "changeset",
    "version": "changeset version",
    "release": "changeset publish"
  },
  "devDependencies": {
    "@babel/core": "^7.28.5",
    "@babel/preset-typescript": "^7.28.5",
    "@biomejs/biome": "2.3.15",
    "@changesets/changelog-github": "^0.5.2",
    "@changesets/cli": "^2.29.8",
    "@types/babel__core": "^7.20.5",
    "@types/bun": "latest",
    "@types/diff": "^8.0.0",
    "@types/turndown": "^5.0.6",
    "babel-preset-solid": "1.9.9",
    "promptfoo": "^0.120.24"
  },
  "peerDependencies": {
    "typescript": "^5"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.29.0",
    "@opentui/core": "^0.1.97",
    "@opentui/solid": "^0.1.97",
    "clipboardy": "^5.3.0",
    "commander": "^14.0.3",
    "diff": "^8.0.3",
    "fuse.js": "^7.1.0",
    "jsonc-parser": "^3.3.1",
    "ollama": "^0.6.3",
    "solid-js": "1.9.9",
    "turndown": "^7.2.4",
    "zod": "^4.3.6"
  }
}
